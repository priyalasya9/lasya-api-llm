# =============================================================================
# AI Chat Application — .gitignore
# =============================================================================

# Environment / secrets — NEVER commit these
.env
*.env

# SQLite database — contains user data, regenerated automatically
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.py[cod]
*.pyo
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
