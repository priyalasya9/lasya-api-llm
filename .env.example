# =============================================================================
# AI Chat Application — Environment Variables
# =============================================================================
# 1. Copy this file:   cp .env.example .env          (Linux / macOS)
#                      copy .env.example .env         (Windows)
# 2. Fill in your values below.
# 3. NEVER commit the .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Your OpenAI secret key.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# -----------------------------------------------------------------------------
# OPTIONAL — sensible defaults are used when these are not set
# -----------------------------------------------------------------------------

# OpenAI model to use for chat and memory extraction.
# Other options: gpt-4o, gpt-3.5-turbo
# Default: gpt-4o-mini
# LLM_MODEL=gpt-4o-mini

# SQLAlchemy database URL.
# Default: SQLite file in the project root.
# For PostgreSQL: postgresql://user:password@localhost:5432/chatdb
# DATABASE_URL=sqlite:///./chats.db

# Comma-separated list of origins allowed to call the FastAPI backend.
# In production, replace with your actual frontend URL.
# Default: http://localhost:8501,http://127.0.0.1:8501
# ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Base URL of the FastAPI backend, used by the Streamlit frontend.
# Change this if you run the backend on a different host or port.
# Default: http://localhost:8000
# API_BASE=http://localhost:8000
