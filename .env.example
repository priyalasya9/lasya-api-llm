# =============================================================================
# AI Chat Application — Environment Variables
# =============================================================================
# LOCAL DEVELOPMENT:
#   1. cp .env.example .env        (Linux/macOS)
#      copy .env.example .env      (Windows)
#   2. Fill in your values.
#   3. Never commit the .env file to version control.
#
# RENDER DEPLOYMENT:
#   Set these in the Render dashboard → service → Environment tab.
#   Do NOT create a .env file on Render — use the dashboard UI.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Your OpenAI secret key.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# -----------------------------------------------------------------------------
# OPTIONAL — sensible defaults are used when not set
# -----------------------------------------------------------------------------

# OpenAI model. Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Default: gpt-4o-mini
# LLM_MODEL=gpt-4o-mini

# SQLAlchemy database URL.
# Default: SQLite file in the project root (chats.db).
# NOTE: On Render free tier, SQLite data is wiped on each deploy.
#       Use a persistent Postgres URL for production data durability.
# DATABASE_URL=sqlite:///./chats.db

# Comma-separated list of origins allowed to reach the FastAPI backend.
# LOCAL: leave as default.
# RENDER: set to your Render frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://lasya-chat-frontend.onrender.com
# ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Base URL of the FastAPI backend, read by the Streamlit frontend.
# LOCAL: leave as default.
# RENDER: set to your Render backend URL, e.g.:
#   API_BASE=https://lasya-chat-backend.onrender.com
# API_BASE=http://localhost:8000
