# Copy this file to .env and fill in your values.

# Required — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# Optional — default: gpt-4o-mini
# Swap for gpt-4o, gemini-*, or any OpenAI-compatible endpoint
LLM_MODEL=gpt-4o-mini

# Optional — default: sqlite:///./chats.db
# DATABASE_URL=sqlite:///./chats.db
